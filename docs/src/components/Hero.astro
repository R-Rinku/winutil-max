---
// Doppler-styled 2-column Hero with real Winutil-MAX screenshot in a Shadow Plum 20px frame.
import { Image } from 'astro:assets';
import { Icon } from '@astrojs/starlight/components';

const PAGE_TITLE_ID = '_top';
const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, image, actions = [] } = data.hero || {};
const { heroEyebrow, heroCaption } = data;

let heroImage: ImageMetadata | undefined;
if (image && 'file' in image) heroImage = image.file;
---

<section class="wu-hero">
	<div class="wu-hero-aurora" aria-hidden="true"></div>
	<div class="wu-hero-inner">
		{/* Left Column: Eyebrow, gradient headline, copyable CLI pill, Signal Green CTA */}
		<div class="wu-hero-copy">
			{heroEyebrow && <span class="wu-eyebrow">{heroEyebrow}</span>}
			<h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
			{tagline && <p class="wu-hero-tagline" set:html={tagline} />}

			<div class="wu-hero-cli">
				<div class="wu-cli-box">
					<div class="wu-cli-cmd">
						<span class="wu-cli-prompt">PS&gt;</span>
						<code>irm "https://rinkurapria.dev/win" | iex</code>
					</div>
					<button
						type="button"
						class="wu-cli-copy"
						data-copy-text='irm "https://rinkurapria.dev/win" | iex'
						aria-label="Copy PowerShell launch command"
					>
						<span class="wu-copy-label">Copy</span>
					</button>
				</div>
				{heroCaption && <p class="wu-hero-caption">{heroCaption}</p>}
			</div>

			{
				actions.length > 0 && (
					<div class="wu-hero-actions">
						{actions.map(({ icon, link: href, text, variant = 'primary' }) => (
							<a href={href} class:list={['wu-btn', variant === 'primary' ? 'wu-btn-primary' : 'wu-btn-secondary']}>
								{text}
								{icon?.name && <Icon name={icon.name} size="1.15em" />}
							</a>
						))}
					</div>
				)
			}
		</div>

		{/* Right Column: Real Winutil-MAX title-screen.png inside a 20px Shadow Plum frame */}
		{
			heroImage && (
				<div class="wu-hero-media">
					<div class="wu-window">
						<div class="wu-window-bar">
							<span class="wu-window-title">Winutil-MAX &mdash; PowerShell GUI</span>
							<span class="wu-window-badge">v2.0</span>
						</div>
						<Image src={heroImage} alt={image?.alt || 'Winutil-MAX light and dark mode interface'} width={1200} loading="eager" decoding="async" />
					</div>
				</div>
			)
		}
	</div>
</section>

<script>
	document.addEventListener('click', async (event) => {
		const btn = (event.target as HTMLElement)?.closest<HTMLButtonElement>('.wu-cli-copy');
		if (!btn) return;
		const text = btn.dataset.copyText;
		if (!text) return;

		try {
			await navigator.clipboard.writeText(text);
		} catch {
			const textarea = document.createElement('textarea');
			textarea.value = text;
			textarea.style.position = 'fixed';
			textarea.style.opacity = '0';
			document.body.appendChild(textarea);
			textarea.select();
			document.execCommand('copy');
			document.body.removeChild(textarea);
		}

		const label = btn.querySelector('.wu-copy-label');
		btn.dataset.copied = 'true';
		if (label) label.textContent = 'Copied!';
		setTimeout(() => {
			btn.dataset.copied = 'false';
			if (label) label.textContent = 'Copy';
		}, 1800);
	});
</script>

<style>
	@layer starlight.core {
		.wu-hero {
			position: relative;
			margin-inline: calc(-1 * var(--sl-content-pad-x));
			padding-inline: var(--sl-content-pad-x);
			margin-top: -1.5rem;
			padding-top: 1.5rem;
			border-bottom: 1px solid rgba(229, 231, 235, 0.08);
			overflow: hidden;
		}

		/* Doppler radial aurora glow behind hero screenshot */
		.wu-hero-aurora {
			position: absolute;
			inset: 0;
			background:
				radial-gradient(ellipse 45% 55% at 72% 45%, rgba(107, 19, 245, 0.22) 0%, transparent 70%),
				radial-gradient(ellipse 35% 40% at 62% 35%, rgba(255, 158, 250, 0.1) 0%, transparent 70%);
			pointer-events: none;
			z-index: 0;
		}

		.wu-hero-inner {
			position: relative;
			z-index: 1;
			max-width: 1200px;
			margin-inline: auto;
			padding-block: 3rem 3.5rem;
			display: grid;
			gap: 2.5rem;
			align-items: center;
		}

		@media (min-width: 56rem) {
			.wu-hero-inner {
				grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
				padding-block: 4rem 4.5rem;
			}
		}

		.wu-hero-copy {
			min-width: 0;
		}

		.wu-hero-copy h1 {
			margin: 0.85rem 0 0;
			font-size: clamp(2.25rem, 4vw, 3.35rem);
			font-weight: 700;
			line-height: 1.05;
			letter-spacing: -0.02em;
			color: var(--color-bone-white);
		}

		.wu-hero-tagline {
			margin: 1rem 0 0;
			font-size: 1rem;
			line-height: 1.55;
			color: var(--color-ash-veil);
		}

		.wu-hero-cli {
			margin-top: 1.4rem;
		}

		.wu-hero-caption {
			margin: 0.5rem 0 0;
			font-size: 0.78rem;
			color: var(--color-mid-ash);
		}

		.wu-hero-actions {
			display: flex;
			flex-wrap: wrap;
			gap: 0.75rem;
			margin-top: 1.35rem;
		}

		.wu-window {
			width: 100%;
			border-radius: 20px;
			border: 1px solid rgba(229, 231, 235, 0.16);
			background: var(--color-shadow-plum);
			box-shadow: 0 0 60px rgba(185, 151, 255, 0.16);
			overflow: hidden;
		}

		.wu-window-bar {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 0.6rem 1rem;
			border-bottom: 1px solid rgba(229, 231, 235, 0.12);
			background: rgba(28, 22, 36, 0.75);
		}

		.wu-window-title {
			font-size: 0.76rem;
			font-weight: 500;
			color: var(--color-ash-veil);
		}

		.wu-window-badge {
			font-size: 0.68rem;
			font-weight: 600;
			padding: 0.15rem 0.55rem;
			border-radius: 9999px;
			background: rgba(185, 151, 255, 0.14);
			color: var(--color-lavender-spark);
			border: 1px solid rgba(185, 151, 255, 0.3);
		}

		.wu-window :global(img) {
			display: block;
			width: 100%;
			height: auto;
		}
	}
</style>
