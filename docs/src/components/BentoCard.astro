---
import { Icon } from '@astrojs/starlight/components';
import type { ComponentProps } from 'astro/types';

interface Props {
	icon: ComponentProps<typeof Icon>['name'];
	title: string;
	badge?: string;
	span?: '1' | '2';
}

const { icon, title, badge, span = '1' } = Astro.props;
---

<div class:list={['wu-bento-card', span === '2' && 'wu-bento-card--wide']}>
	<div class="wu-bento-header">
		<div class="wu-bento-icon">
			<Icon name={icon} size="1.25rem" />
		</div>
		{badge && <span class="wu-bento-tag">{badge}</span>}
	</div>
	<h3>{title}</h3>
	<div class="wu-bento-desc"><slot /></div>
</div>

<style>
	.wu-bento-card {
		display: flex;
		flex-direction: column;
		gap: 0.8rem;
		padding: 1.75rem;
		border-radius: 20px;
		background: var(--color-shadow-plum, #2d2734);
		border: 1px solid rgba(229, 231, 235, 0.14);
		transition: border-color 0.2s cubic-bezier(0.16, 1, 0.3, 1), transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.wu-bento-card--wide {
		grid-column: span 1;
	}

	@media (min-width: 50rem) {
		.wu-bento-card--wide {
			grid-column: span 2;
		}
	}

	.wu-bento-card:hover {
		border-color: rgba(185, 151, 255, 0.45);
		transform: translateY(-2px);
	}

	.wu-bento-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.wu-bento-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 10px;
		background: rgba(185, 151, 255, 0.12);
		border: 1px solid rgba(185, 151, 255, 0.28);
		color: var(--color-lavender-spark, #b997ff);
	}

	.wu-bento-tag {
		font-size: 0.7rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		padding: 0.2rem 0.6rem;
		border-radius: 8px;
		background: rgba(185, 151, 255, 0.1);
		border: 1px solid rgba(185, 151, 255, 0.25);
		color: var(--color-lavender-spark, #b997ff);
	}

	.wu-bento-card h3 {
		margin: 0;
		font-size: 1.25rem;
		font-weight: 500;
		color: var(--color-bone-white, #f1f0ec);
		letter-spacing: -0.01em;
		line-height: 1.25;
	}

	.wu-bento-desc {
		font-size: 0.92rem;
		line-height: 1.55;
		color: var(--color-ash-veil, #d0c9c4);
	}

	.wu-bento-desc :global(p) {
		margin: 0;
	}
</style>
