---
import config from 'virtual:starlight/user-config';

import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import { Icon } from '@astrojs/starlight/components';

const shouldRenderSearch =
	config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';

const { hasSidebar } = Astro.locals.starlightRoute;
---

<div class="header">
	<div class="title-wrapper sl-flex">
		<SiteTitle />
	</div>

	<div class="mobile-actions sl-flex">
		<div class="sl-flex print:hidden">
			{shouldRenderSearch && <Search />}
		</div>
		{
			!hasSidebar && (
				<div class="site-nav-toggle sl-flex md:sl-hidden print:hidden">
					<button type="button" aria-expanded="false" aria-controls="site-nav-panel" aria-label="Site navigation">
						<Icon name="bars" class="open-menu" />
						<Icon name="close" class="close-menu" />
					</button>
					<div id="site-nav-panel" class="site-nav-panel">
						<div class="site-nav-panel-group">
							<p class="site-nav-panel-heading">Documentation</p>
							<a href="/guides/">User Guides</a>
							<a href="/guides/tweaks/">Tweaks</a>
							<a href="/guides/win11creator/">Win11 ISO Creator</a>
							<a href="/code-reference/architecture/">Architecture</a>
						</div>
						<div class="site-nav-panel-group">
							<p class="site-nav-panel-heading">Community</p>
							<a href="/faq/">FAQ</a>
							<a href="/knownissues/">Known Issues</a>
							<a href="/contributing/">Contributing</a>
						</div>
						<a class="site-nav-panel-link" href="/#bootstrap">Launch Script →</a>
					</div>
				</div>
			)
		}
	</div>

	<div class="sl-hidden md:sl-flex print:hidden right-group">
		<nav class="site-nav" aria-label="Top">
			<a class="site-nav-link" href="/guides/">Docs</a>
			<a class="site-nav-link" href="/guides/tweaks/">Tweaks</a>
			<a class="site-nav-link" href="/guides/win11creator/">Win11 ISO</a>
			<div class="site-nav-dropdown">
				<details name="site-nav-dropdown">
					<summary class="site-nav-link">More</summary>
				</details>
				<div class="site-nav-menu">
					<a href="/code-reference/architecture/">Architecture</a>
					<a href="/faq/">FAQ</a>
					<a href="/knownissues/">Known Issues</a>
					<a href="/contributing/">Contributing</a>
				</div>
			</div>
		</nav>

		<div class="sl-flex social-icons">
			<SocialIcons />
		</div>

		<a class="wu-nav-cta" href="/#bootstrap">Launch Script &rarr;</a>
		<ThemeSelect />
		<LanguageSelect />
	</div>
</div>

<script>
	const toggle = document.querySelector<HTMLElement>('.site-nav-toggle');
	const btn = toggle?.querySelector('button');

	if (toggle && btn) {
		const setExpanded = (expanded: boolean) => btn.setAttribute('aria-expanded', String(expanded));

		btn.addEventListener('click', () => setExpanded(btn.getAttribute('aria-expanded') !== 'true'));
		toggle.addEventListener('keyup', (e) => {
			if (e.code === 'Escape') {
				setExpanded(false);
				btn.focus();
			}
		});
		matchMedia('(min-width: 50em)').addEventListener('change', () => setExpanded(false));
	}
</script>

<style>
	@layer starlight.core {
		.header {
			display: flex;
			gap: var(--sl-nav-gap);
			justify-content: space-between;
			align-items: center;
			height: 100%;
		}

		.title-wrapper {
			overflow: clip;
			padding: 0.25rem;
			margin: -0.25rem;
			min-width: 0;
		}

		.mobile-actions {
			align-items: center;
			gap: 0.75rem;
		}

		.right-group,
		.social-icons {
			gap: 1rem;
			align-items: center;
		}

		@media (min-width: 50rem) {
			:global(:root[data-has-sidebar]) {
				--__sidebar-pad: calc(2 * var(--sl-nav-pad-x));
			}
			:global(:root:not([data-has-toc])) {
				--__toc-width: 0rem;
			}
			.header {
				--__sidebar-width: max(0rem, var(--sl-content-inline-start, 0rem) - var(--sl-nav-pad-x));
				--__main-column-fr: calc(
					(
							100% + var(--__sidebar-pad, 0rem) - var(--__toc-width, var(--sl-sidebar-width)) -
								(2 * var(--__toc-width, var(--sl-nav-pad-x))) - var(--sl-content-inline-start, 0rem) -
								var(--sl-content-width)
						) / 2
				);
				display: grid;
				grid-template-columns:
					minmax(
						calc(var(--__sidebar-width) + max(0rem, var(--__main-column-fr) - var(--sl-nav-gap))),
						auto
					)
					1fr
					auto;
				align-content: center;
			}
		}
	}

	.site-nav {
		display: flex;
		align-items: center;
		gap: 1.35rem;
		padding-inline-end: 1.25rem;
		border-inline-end: 1px solid rgba(229, 231, 235, 0.12);
	}

	.site-nav-link {
		font-size: 0.875rem;
		font-weight: 450;
		color: var(--color-ash-veil, #d0c9c4);
		background: none;
		border: none;
		padding: 0;
		font-family: inherit;
		cursor: pointer;
		white-space: nowrap;
		text-decoration: none;
		transition: color 0.15s ease;
	}
	.site-nav-link:hover {
		color: var(--color-bone-white, #f1f0ec);
	}

	.wu-nav-cta {
		display: inline-flex;
		align-items: center;
		padding: 0.45rem 0.9rem;
		border-radius: 10px;
		background: var(--color-signal-green, #00f575);
		color: #000000 !important;
		font-size: 0.82rem;
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
		transition: transform 0.15s ease, filter 0.15s ease;
	}
	.wu-nav-cta:hover {
		filter: brightness(1.06);
		transform: translateY(-1px);
	}

	.site-nav-dropdown {
		position: relative;
		padding-bottom: 0.75rem;
		margin-bottom: -0.75rem;
	}
	.site-nav-dropdown > details {
		display: contents;
	}
	.site-nav-dropdown > details > summary {
		display: inline-flex;
		align-items: center;
		list-style: none;
	}
	.site-nav-dropdown > details > summary::-webkit-details-marker {
		display: none;
	}
	.site-nav-menu {
		display: none;
		position: absolute;
		top: 100%;
		left: 50%;
		transform: translateX(-50%);
		min-width: 11.5rem;
		padding: 0.5rem;
		flex-direction: column;
		gap: 0.15rem;
		background: var(--color-shadow-plum, #2d2734);
		border: 1px solid rgba(229, 231, 235, 0.14);
		border-radius: 12px;
		box-shadow: 0 16px 32px rgba(0, 0, 0, 0.45);
		z-index: 20;
	}
	.site-nav-dropdown:hover .site-nav-menu,
	.site-nav-dropdown:has(details[open]) .site-nav-menu {
		display: flex;
	}
	.site-nav-menu a {
		padding: 0.45rem 0.65rem;
		border-radius: 8px;
		font-size: 0.85rem;
		color: var(--color-ash-veil, #d0c9c4);
		text-decoration: none;
		white-space: nowrap;
	}
	.site-nav-menu a:hover {
		color: var(--color-bone-white, #f1f0ec);
		background: rgba(185, 151, 255, 0.12);
	}

	.site-nav-toggle button {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		border: 0;
		border-radius: 8px;
		padding: 0;
		background: none;
		color: var(--color-ash-veil, #d0c9c4);
		cursor: pointer;
	}
	.site-nav-toggle button:hover {
		color: var(--color-bone-white, #f1f0ec);
	}
	.site-nav-toggle button svg {
		width: 1.25rem;
		height: 1.25rem;
	}
	.site-nav-toggle button[aria-expanded='true'] .open-menu,
	.site-nav-toggle button:not([aria-expanded='true']) .close-menu {
		display: none;
	}

	.site-nav-panel {
		display: none;
		position: fixed;
		inset-inline: 0;
		top: var(--sl-nav-height);
		z-index: var(--sl-z-index-menu);
		flex-direction: column;
		gap: 0.25rem;
		max-height: calc(100vh - var(--sl-nav-height));
		overflow-y: auto;
		padding: 1rem var(--sl-nav-pad-x) 1.5rem;
		background: var(--color-midnight-plum, #1c1624);
		border-bottom: 1px solid rgba(229, 231, 235, 0.14);
	}
	.site-nav-toggle button[aria-expanded='true'] ~ .site-nav-panel {
		display: flex;
	}
	.site-nav-panel-link {
		padding: 0.6rem 0.25rem;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--color-signal-green, #00f575);
		text-decoration: none;
	}
	.site-nav-panel-group {
		display: flex;
		flex-direction: column;
		border-top: 1px solid rgba(229, 231, 235, 0.1);
		padding-top: 0.5rem;
	}
	.site-nav-panel-heading {
		margin: 0 0 0.25rem;
		padding: 0 0.25rem;
		font-size: 0.72rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--color-lavender-spark, #b997ff);
	}
	.site-nav-panel-group a {
		padding: 0.45rem 0.25rem;
		font-size: 0.875rem;
		color: var(--color-ash-veil, #d0c9c4);
		text-decoration: none;
	}
	.site-nav-panel-group a:hover {
		color: var(--color-bone-white, #f1f0ec);
	}
</style>
